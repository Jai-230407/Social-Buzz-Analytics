table Reactions

	measure 'Total Popularity' = SUM(Reactions[Score])
		formatString: #,##0

	measure 'Reaction Events' = COUNTROWS(Reactions)
		formatString: #,##0

	measure 'Unique Posts' = DISTINCTCOUNT(Reactions[Content ID])
		formatString: #,##0

	measure 'Distinct Categories' = DISTINCTCOUNT(Reactions[Category])
		formatString: #,##0

	measure 'Points per Reaction' = DIVIDE([Total Popularity], [Reaction Events])
		formatString: 0.0

	measure 'Points per Post' = DIVIDE([Total Popularity], [Unique Posts])
		formatString: #,##0.0

	measure 'Positive Reactions' = CALCULATE([Reaction Events], Reactions[Sentiment] = "positive")
		formatString: #,##0

	measure 'Positive Share' = DIVIDE([Positive Reactions], [Reaction Events])
		formatString: 0.0%

	column 'Reaction ID'
		dataType: string
		sourceColumn: Reaction ID
		summarizeBy: none

	column 'Content ID'
		dataType: string
		sourceColumn: Content ID
		summarizeBy: none

	column Category
		dataType: string
		sourceColumn: Category
		summarizeBy: none

	column 'Content Type'
		dataType: string
		sourceColumn: Content Type
		summarizeBy: none

	column 'Reaction Type'
		dataType: string
		sourceColumn: Reaction Type
		summarizeBy: none

	column Sentiment
		dataType: string
		sourceColumn: Sentiment
		summarizeBy: none

	column Score
		dataType: double
		sourceColumn: Score
		summarizeBy: none

	column Datetime
		dataType: dateTime
		sourceColumn: Datetime
		summarizeBy: none

	column Date
		dataType: string
		sourceColumn: Date
		summarizeBy: none

	column Month
		dataType: string
		sourceColumn: Month
		summarizeBy: none

	column 'Month Name'
		dataType: string
		sourceColumn: Month Name
		summarizeBy: none

	column Year
		dataType: int64
		sourceColumn: Year
		summarizeBy: none

	partition Reactions = m
		mode: import
		source =
			let
				Compressed = Binary.FromText("", BinaryEncoding.Base64),
				RawBytes = Binary.Decompress(Compressed, Compression.Deflate),
				Parsed = Csv.Document(RawBytes, [Delimiter=",", Columns=12, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {
					{"Reaction ID", type text}, {"Content ID", type text}, {"Category", type text},
					{"Content Type", type text}, {"Reaction Type", type text}, {"Sentiment", type text},
					{"Score", type number}, {"Datetime", type datetime}, {"Date", type text},
					{"Month", type text}, {"Month Name", type text}, {"Year", Int64.Type}
				}, "en-US")
			in
				Typed
